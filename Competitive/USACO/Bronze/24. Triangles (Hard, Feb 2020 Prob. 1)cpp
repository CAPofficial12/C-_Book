#include <bits/stdc++.h>
using namespace std;
using ll = long long int;
using pai = pair<ll, ll>;

int main(){
    ios::sync_with_stdio(0);
    cin.tie(0);
    freopen("triangles.in","r", stdin);
    freopen("triangles.out", "w", stdout);

    ll n;
    cin >> n;
    vector<pai> X(n);
    pai a;
    for(int i = 0; i < n; i++){
        cin >> a.first >> a.second;
        X[i] = a;
    }

    ll area = LLONG_MIN;
    for(ll i = 0; i < n; i++){
        for(ll j = 0; j < n; j++){
            for(ll k = 0; k < n; k++){
                pai centre = X[i];
                pai down = X[j];
                pai side = X[k];
                if(down.first == centre.first && side.second == centre.second){
                    area = max(area,abs((down.second-centre.second) * (side.first - centre.first)));
                }
            }
        }
    }
    cout << area;
    return 0;
}